# ===========================================
# Frontend Environment Variables
# ===========================================

# Firebase Configuration (required for authentication)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id

# Google Drive API Key (optional - only for public folders direct access)
VITE_GOOGLE_DRIVE_API_KEY=

# ===========================================
# Backend URL Configuration
# ===========================================
# 
# LOCAL DEVELOPMENT (using node dev.js):
#   Leave VITE_VPS_BACKEND_URL empty or commented out
#   The Vite proxy will forward /api requests to http://localhost:3001
#
# PRODUCTION:
#   Set this to your VPS backend URL
#   Example: VITE_VPS_BACKEND_URL=https://api.your-domain.com
#
# VITE_VPS_BACKEND_URL=https://your-vps-domain.com