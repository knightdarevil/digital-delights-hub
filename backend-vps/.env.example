# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Firebase Admin (optional - for user verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ===========================================
# Google Service Account Configuration
# ===========================================
# 
# OPTION 1: Base64 encoded JSON (RECOMMENDED for security)
# Run this command to encode your JSON file:
# cat your-service-account.json | base64 -w 0
# Then paste the result here:
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# OPTION 2: Raw JSON string (easier for testing)
# Paste the entire JSON content in one line:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ===========================================
# Google Drive Folder IDs
# ===========================================
# Get folder ID from URL: https://drive.google.com/drive/folders/FOLDER_ID
# IMPORTANT: Share each folder with your Service Account email!

DRIVE_FOLDER_MOVIES=
DRIVE_FOLDER_SOFTWARE=
DRIVE_FOLDER_COURSES=
DRIVE_FOLDER_WINDOWS=
DRIVE_FOLDER_DRIVER=

# Download limits
WEEKLY_DOWNLOAD_LIMIT=3
