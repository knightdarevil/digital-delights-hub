# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# JWT Secret for authentication (change this in production!)
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# Google Service Account Configuration
# ===========================================
# 
# STEP 1: Create a Service Account in Google Cloud Console
#   1. Go to https://console.cloud.google.com
#   2. Create a new project or select existing one
#   3. Enable Google Drive API
#   4. Go to IAM & Admin > Service Accounts
#   5. Create a new Service Account
#   6. Create a key (JSON format)
#   7. Download the JSON file
#
# STEP 2: Share your Drive folders with the Service Account email
#   - The email looks like: your-service@project-id.iam.gserviceaccount.com
#   - Right-click folder > Share > Add the service account email with "Viewer" access
#
# STEP 3: Configure the key (choose ONE option):

# OPTION 1: JSON string (paste entire JSON in one line)
# Copy the contents of your service account JSON file here:
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service@your-project.iam.gserviceaccount.com","client_id":"123","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# OPTION 2: Base64 encoded JSON (more secure, recommended for production)
# Run this command to encode your JSON file:
#   cat your-service-account.json | base64 -w 0 (Linux/Mac)
#   certutil -encode your-service-account.json temp.b64 && type temp.b64 (Windows)
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# ===========================================
# Google Drive Folder IDs (optional)
# ===========================================
# These are used for the /api/drive/list/:category endpoints
# Get folder ID from URL: https://drive.google.com/drive/folders/FOLDER_ID
# 
# IMPORTANT: Share each folder with your Service Account email!

DRIVE_FOLDER_MOVIES=
DRIVE_FOLDER_SOFTWARE=
DRIVE_FOLDER_COURSES=
DRIVE_FOLDER_WINDOWS=
DRIVE_FOLDER_DRIVER=

# ===========================================
# Firebase Admin SDK (for License Key verification)
# ===========================================
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON content here (minified, on one line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"123","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ===========================================
# Download Limits
# ===========================================
# Maximum downloads per week for non-VIP users
WEEKLY_DOWNLOAD_LIMIT=3
